{
  "name": "WKT coordinate reference system",
  "scopeName": "source.wkt",
  "patterns": [
    {
      "name": "meta.proj-parameters.wkt",
      "begin": "^\\s*(?=\\+)",
      "end": "$",
      "patterns": [
        {
          "name": "string.quoted.double.proj.wkt",
          "begin": "(?<==)\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.proj.wkt",
              "match": "\\\\."
            }
          ],
          "applyEndPatternLast": true
        },
        {
          "name": "string.quoted.single.proj.wkt",
          "begin": "(?<==)'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.proj.wkt",
              "match": "\\\\."
            }
          ],
          "applyEndPatternLast": true
        },
        {
          "name": "variable.parameter.proj.wkt",
          "match": "\\+[A-Za-z_][A-Za-z_0-9]*(?==|\\s|$)"
        },
        {
          "name": "keyword.operator.assignment.proj.wkt",
          "match": "="
        },
        {
          "name": "constant.numeric.proj.wkt",
          "match": "(?<![A-Za-z_0-9])[-+]?(?:\\d+\\.?\\d*|\\.\\d+)(?:[eE][-+]?\\d+)?(?![A-Za-z_0-9])"
        }
      ]
    },
    {
      "name": "string.quoted.double.wkt",
      "begin": "\"",
      "end": "\"(?!\")",
      "patterns": [
        {
          "name": "constant.character.escape.wkt",
          "match": "\"\""
        }
      ]
    },
    {
      "name": "entity.name.function.wkt",
      "match": "\\b[A-Za-z_][A-Za-z_0-9]*(?=\\s*[\\[(])"
    },
    {
      "name": "constant.numeric.wkt",
      "match": "(?<![A-Za-z_0-9])[-+]?(?:\\d+\\.?\\d*|\\.\\d+)(?:[eE][-+]?\\d+)?(?![A-Za-z_0-9])"
    },
    {
      "name": "constant.language.wkt",
      "match": "\\b(?:north|south|east|west|up|down|geocentricX|geocentricY|geocentricZ|Cartesian|ellipsoidal|spherical|vertical|temporal|ordinal|parametric|other|future|past|clockwise|counterClockwise)\\b"
    },
    {
      "name": "punctuation.definition.wkt",
      "match": "[\\[\\](),]"
    }
  ]
}
